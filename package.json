{
  "name": "darknode-cli",
  "version": "2.46.3",
  "description": "Darknode — AI security platform CLI. AI-powered security platform with Nexus AI engine for Windows and Linux: native port scanner, reverse shells, encoders, payloads, and cheat sheets.",
  "homepage": "https://darknode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darknode-Official/darknode-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Darknode-Official/darknode-cli/issues"
  },
  "bin": {
    "darknode": "darknode.js",
    "nexus": "darknode.js"
  },
  "main": "darknode.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node darknode.js",
    "build": "pkg . --out-path dist",
    "test": "node test/run.js && node test/authz.test.js && node test/composer.test.js && node test/term.test.js && node test/md-render.test.js && node test/links.test.js && node test/pager.test.js",
    "postinstall": "node scripts/postinstall.js",
    "docs": "node scripts/gen-nexus-docs.js"
  },
  "pkg": {
    "targets": [
      "node18-linux-x64",
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "security",
    "pentest",
    "cli",
    "tui",
    "port-scanner",
    "reverse-shell",
    "hacking",
    "infosec",
    "recon",
    "terminal"
  ],
  "author": "Darknode",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "darknode.js",
    "darknode-legacy.js",
    "lib/",
    "test/",
    "scripts/",
    "command-ref.json"
  ]
}
