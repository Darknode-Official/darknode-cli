diff --git a/csv.js b/csv.js
index 70cc759c68645810f604567e1e829655dff9c942..80e6cfbf151fca733e55bf6549b2951536f70bb8
--- a/csv.js
+++ b/csv.js
@@ -1,5 +1,10 @@
 // Parse simple CSV (no quoting) into an array of row arrays.
 function parseCSV(text) {
-  return String(text).split("\n").map((line) => line.split(",")); // BUG: "" -> [[""]]; trailing "\n" -> extra [""]
+  const value = String(text);
+  if (value === "") return [];
+
+  const lines = value.split("\n");
+  if (value.endsWith("\n")) lines.pop();
+  return lines.map((line) => line.split(","));
 }
 module.exports = { parseCSV };

